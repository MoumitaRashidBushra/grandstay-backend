# Settings for the API test suite (npm run test:e2e). Committed on purpose: these are
# throwaway credentials for the local test container (docker-compose.test.yml), not secrets.
# Variables already set in the environment (e.g. by CI) take precedence over this file.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:password@localhost:5433/grandstay_test
JWT_SECRET=local-test-secret
JWT_EXPIRES_IN=1h
