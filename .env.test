qa/fr-auth-api-tests


# Settings for the API test suite (npm run test:e2e).
# DATABASE_URL is read from the environment or local .env and redirected to the
# isolated grandstay_test schema. Variables already set in the environment (CI) win.

NODE_ENV=test
JWT_SECRET=local-test-secret
JWT_ACCESS_SECRET=local-test-secret-for-grandstay-api-tests
JWT_EXPIRES_IN=1h
