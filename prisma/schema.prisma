// GrandStay Hotel Booking (Group 3) — Prisma 5 schema
// Source: SRS-G3-GrandStay-v0.1.pdf, section 5.2 PostgreSQL DDL
//
// Things Prisma cannot express are NOT modelled here and must be added in a
// hand-edited SQL migration (see bottom of file for the list).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

// ───────────── Enums ─────────────

enum UserRole {
  ADMIN
  RECEPTIONIST
  CUSTOMER

  @@map("user_role")
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED

  @@map("room_status")
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED

  @@map("booking_status")
}

// ───────────── Models ─────────────

/// Single-row table (id is always 1, enforced by CHECK in SQL).
model HotelSettings {
  id           Int      @id @default(1) @db.SmallInt
  name         String   @db.VarChar(120)
  address      String   @db.VarChar(255)
  phone        String   @db.VarChar(20)
  email        String   @db.VarChar(254)
  checkinTime  DateTime @default(dbgenerated("'14:00'::time")) @map("checkin_time") @db.Time(6)
  checkoutTime DateTime @default(dbgenerated("'12:00'::time")) @map("checkout_time") @db.Time(6)
  timezone     String   @default("Asia/Dhaka") @db.VarChar(40)

  @@map("hotel_settings")
}

model RoomCategory {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  name         String   @unique @db.VarChar(40) // Standard, Deluxe, Suite
  nightlyPrice Decimal  @map("nightly_price") @db.Decimal(12, 2)
  capacity     Int      @db.SmallInt
  description  String   @default("")
  facilities   String[] @default([])
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("room_categories")
}

model Room {
  id         Int        @id @default(autoincrement())
  number     String     @unique @db.VarChar(10)
  categoryId Int        @map("category_id") @db.SmallInt
  floor      Int        @db.SmallInt
  status     RoomStatus @default(AVAILABLE)
  statusNote String?    @map("status_note") @db.VarChar(255)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  category RoomCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@map("rooms")
}

model User {
  id           BigInt    @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  mobile       String?   @db.Char(11) // CHECK ~ '^01[3-9][0-9]{8}$'
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  mustResetPw  Boolean   @default(false) @map("must_reset_pw")
  failedLogins Int       @default(0) @map("failed_logins") @db.SmallInt
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings           Booking[]        @relation("BookingCustomer")
  checkedInBookings  Booking[]        @relation("BookingCheckedInBy")
  checkedOutBookings Booking[]        @relation("BookingCheckedOutBy")
  issuedInvoices     Invoice[]
  idempotencyKeys    IdempotencyKey[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Booking {
  id              BigInt        @id @default(autoincrement())
  reference       String        @unique @db.Char(15) // GS-YYMMDD-XXXXX
  customerId      BigInt        @map("customer_id")
  roomId          Int           @map("room_id")
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime      @map("check_out") @db.Date
  /// GENERATED ALWAYS AS (daterange(check_in, check_out, '[)')) STORED — managed by the DB, used by the EXCLUDE constraint.
  stay            Unsupported("daterange")?
  /// GENERATED ALWAYS AS (check_out - check_in) STORED — read-only; never write it from the client.
  nights          Int?          @db.SmallInt
  guests          Int           @db.SmallInt
  leadGuestName   String        @map("lead_guest_name") @db.VarChar(120)
  leadGuestMobile String        @map("lead_guest_mobile") @db.Char(11)
  nightlyPrice    Decimal       @map("nightly_price") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          BookingStatus @default(CONFIRMED)
  confirmedAt     DateTime      @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  checkedInAt     DateTime?     @map("checked_in_at") @db.Timestamptz(6)
  checkedInById   BigInt?       @map("checked_in_by")
  checkedOutAt    DateTime?     @map("checked_out_at") @db.Timestamptz(6)
  checkedOutById  BigInt?       @map("checked_out_by")

  customer     User     @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkedInBy  User?    @relation("BookingCheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy User?    @relation("BookingCheckedOutBy", fields: [checkedOutById], references: [id])
  payment      Payment?
  refund       Refund?
  invoice      Invoice?

  @@index([customerId, checkIn(sort: Desc)], map: "bookings_customer")
  // Partial indexes bookings_checkin / bookings_checkout are created in raw SQL.
  @@map("bookings")
}

model Payment {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @unique @map("booking_id")
  amount    Decimal  @db.Decimal(12, 2) // CHECK (amount > 0)
  method    String   @default("SIMULATED_CARD") @db.VarChar(20)
  cardLast4 String   @map("card_last4") @db.Char(4)
  status    String   @default("SUCCEEDED") @db.VarChar(12) // CHECK (status = 'SUCCEEDED')
  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("payments")
}

model Refund {
  id         BigInt   @id @default(autoincrement())
  bookingId  BigInt   @unique @map("booking_id")
  amount     Decimal  @db.Decimal(12, 2) // CHECK (amount >= 0)
  reason     String   @default("Customer cancellation") @db.VarChar(255)
  refundedAt DateTime @default(now()) @map("refunded_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

model Invoice {
  id          BigInt   @id @default(autoincrement())
  number      String   @unique @db.Char(15) // INV-YYYY-NNNNNN
  bookingId   BigInt   @unique @map("booking_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  paidAmount  Decimal  @map("paid_amount") @db.Decimal(12, 2)
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById  BigInt   @map("issued_by")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  issuedBy User    @relation(fields: [issuedById], references: [id])

  @@map("invoices")
}

model IdempotencyKey {
  userId       BigInt   @map("user_id")
  key          String   @db.Uuid
  requestHash  String   @map("request_hash") @db.Char(64)
  responseCode Int?     @map("response_code") @db.SmallInt
  responseBody Json?    @map("response_body") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, key])
  @@map("idempotency_keys")
}

/// Append-only (enforce with a trigger / revoked UPDATE, DELETE privileges).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   BigInt   @map("entity_id")
  beforeData Json?    @map("before_data") @db.JsonB
  afterData  Json?    @map("after_data") @db.JsonB
  requestId  String   @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ───────────── Not expressible in Prisma — add via custom SQL migration ─────────────
// Run `prisma migrate dev --create-only`, then append to the generated migration.sql:
//
//   -- CHECK constraints
//   ALTER TABLE hotel_settings   ADD CHECK (id = 1);
//   ALTER TABLE room_categories  ADD CHECK (nightly_price > 0), ADD CHECK (capacity BETWEEN 1 AND 10);
//   ALTER TABLE users            ADD CHECK (mobile ~ '^01[3-9][0-9]{8}$');
//   ALTER TABLE bookings         ADD CHECK (guests >= 1), ADD CHECK (check_out > check_in),
//                                ADD CHECK (check_out - check_in <= 30),
//                                ADD CHECK (total_amount = nightly_price * (check_out - check_in));
//   ALTER TABLE payments         ADD CHECK (amount > 0), ADD CHECK (status = 'SUCCEEDED');
//   ALTER TABLE refunds          ADD CHECK (amount >= 0);
//
//   -- Generated columns: edit the generated CREATE TABLE so these are defined as in the SRS
//   --   stay   DATERANGE GENERATED ALWAYS AS (daterange(check_in, check_out, '[)')) STORED
//   --   nights SMALLINT  GENERATED ALWAYS AS (check_out - check_in) STORED
//
//   -- Double-booking guarantee
//   ALTER TABLE bookings ADD CONSTRAINT bookings_no_overlap
//     EXCLUDE USING gist (room_id WITH =, stay WITH &&)
//     WHERE (status IN ('CONFIRMED','CHECKED_IN'));
//
//   -- Partial indexes
//   CREATE INDEX bookings_checkin  ON bookings (check_in)  WHERE status = 'CONFIRMED';
//   CREATE INDEX bookings_checkout ON bookings (check_out) WHERE status = 'CHECKED_IN';
