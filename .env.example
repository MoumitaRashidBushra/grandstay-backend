# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (Compose)
POSTGRES_DB=grandstay_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/grandstay_db


# JWT
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1d